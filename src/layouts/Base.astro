---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import TopBar, { type Crumb } from '../components/TopBar.astro';
import ExamCard from '../components/ExamCard.astro';
import EnrollmentDialog from '../components/EnrollmentDialog.astro';
import { STORAGE_KEYS } from '../data/storage';

interface Props {
  title: string;
  description?: string;
  /** Con panel lateral (portada y asignaturas). Las páginas de lectura van sin él. */
  sidebar?: boolean;
  /** Migas de la página (pendiente de decidir dónde se muestran) */
  crumbs?: Crumb[];
  /** Aviso azul del calendario bajo la barra superior */
  banner?: boolean;
}

const {
  title,
  description = 'Apuntes, ejercicios y soluciones de DAW, tema a tema.',
  sidebar = true,
  crumbs = [],
  banner = true,
} = Astro.props;

const siteName = 'estudiodaw.dev';
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline define:vars={{ keys: STORAGE_KEYS }}>
      // Tema antes del primer pintado: claro por defecto; oscuro solo si se eligió.
      // Con ClientRouter el <html> se sustituye en cada navegación: se vuelve a aplicar.
      (() => {
        const apply = () => {
          const root = document.documentElement;
          let theme = 'light';
          try {
            if (localStorage.getItem(keys.theme) === 'dark') theme = 'dark';
          } catch {}
          root.classList.toggle('dark', theme === 'dark');
          root.style.colorScheme = theme;
          // Vista de las colecciones (rejilla o lista), elegida con <ViewToggle />
          try {
            root.dataset.view = localStorage.getItem(keys.view) === 'list' ? 'list' : 'grid';
          } catch {
            root.dataset.view = 'grid';
          }
          window.__applyEnrollmentStyle();
        };
        // Filtro de "Mi matrícula": oculta lo que lleva data-subject de módulos no marcados
        // (y los grupos que se quedan vacíos). Lo reutiliza <EnrollmentDialog /> al confirmar.
        // También recoloca las líneas de la rejilla (una sí y otra no entre lo visible),
        // que si no se descuadran hasta que corre el script de la matrícula.
        window.__applyEnrollmentStyle = () => {
          let ids = [];
          try {
            ids = JSON.parse(localStorage.getItem(keys.enrollment) || '[]');
          } catch {}
          let style = document.getElementById('enrollment-style');
          if (!Array.isArray(ids) || !ids.length) {
            if (style) style.remove();
            return;
          }
          const match = ids.map((id) => '[data-subject="' + String(id).replace(/[^\w-]/g, '') + '"]').join(',');
          if (!style) {
            style = document.createElement('style');
            style.id = 'enrollment-style';
            document.head.appendChild(style);
          }
          style.textContent =
            '[data-subject]:not(' + match + '){display:none!important}' +
            '[data-subject-group]:not(:has(' + match + ')){display:none!important}' +
            '@media (min-width:40rem){' +
            '.item-grid>li:is(' + match + ')::before,.item-grid>li:is(' + match + ')::after{content:""!important}' +
            '.item-grid>li:nth-child(2n of :is(' + match + '):not([hidden]))::before,' +
            '.item-grid>li:nth-child(2n of :is(' + match + '):not([hidden]))::after{content:none!important}}';
        };
        apply();
        if (!window.__themeSwapHook) {
          window.__themeSwapHook = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Vista previa al compartir el enlace (WhatsApp, Telegram, Discord...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/GeistPixel-Square.woff2" as="font" type="font/woff2" crossorigin />
    <Font cssVariable="--font-funnel-sans" preload={[{ style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-cardo" />
    <!-- Navegación sin recarga: el panel lateral persiste entre la portada y las asignaturas -->
    <ClientRouter />
  </head>
  <!-- Marco de designeer: canaletas rayadas a los lados, panel fijo a la izquierda
       y el cuerpo de chanhdai a la derecha, con sus líneas recortadas dentro.
       Sin panel (páginas de lectura) el marco se estrecha a la columna de chanhdai. -->
  <body class="hatch min-h-dvh" data-sidebar={sidebar ? '' : undefined}>
    <div class:list={['frame mx-auto w-full', sidebar ? 'max-w-[66rem]' : 'max-w-3xl']}>
      <div class:list={[sidebar && 'lg:grid lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-start']}>
        {
          sidebar && (
            <Sidebar class="max-lg:hidden" />
          )
        }

        <div class:list={['app-main relative isolate min-w-0 overflow-x-clip', sidebar && 'lg:border-l']}>
          <Navbar class={sidebar ? 'lg:hidden' : undefined} />
          {sidebar && <TopBar />}
          {sidebar && banner && <ExamCard />}
          <main class="px-2 lg:px-0">
            <slot />
          </main>
          <Footer />
        </div>
      </div>
    </div>

    <EnrollmentDialog />

    <!-- Fundido inferior fijo (chanhdai), limitado a la columna del cuerpo en escritorio -->
    <div class="bottom-fade pointer-events-none fixed bottom-0 z-50" aria-hidden="true">
      <div class="h-(--fade-bottom-height) bg-linear-to-b from-transparent to-background mask-linear-[to_top,var(--background)_25%,transparent] backdrop-blur-[1px]"></div>
      <div class="bg-background pb-[env(safe-area-inset-bottom,0)]"></div>
    </div>
  </body>
</html>
