---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import ItemGrid from '../../components/ItemGrid.astro';
import PageHeading from '../../components/PageHeading.astro';
import Panel from '../../components/Panel.astro';
import Separator from '../../components/Separator.astro';

export async function getStaticPaths() {
  const subjects = await getCollection('subjects');
  return subjects.map((subject) => ({
    params: { subject: subject.id },
    props: { subject },
  }));
}

const { subject } = Astro.props;
const temas = (await getCollection('temas'))
  .filter((t) => t.data.subject === subject.id)
  .sort((a, b) => a.data.number - b.data.number);
const docs = await getCollection('docs');

const kindLabel = { teoria: 'Teoría', ejercicios: 'Ejercicios', soluciones: 'Soluciones' };
const docsOf = (slug: string) =>
  docs
    .filter((d) => d.id.startsWith(`${subject.id}/${slug}/`))
    .map((d) => kindLabel[d.data.kind])
    .join(' · ');

const tagline = `<a href="/" class="hover:text-foreground transition-colors">Asignaturas</a> / ${subject.data.short} · ${subject.data.year === 1 ? 'Pendiente de 1º' : '2º curso'}`;
---

<Base title={subject.data.name} description={subject.data.description} crumbs={[{ label: 'Inicio', href: '/' }, { label: 'Asignaturas', href: '/#asignaturas' }, { label: subject.data.name }]}>
  <div class="mx-auto md:max-w-3xl">
    <PageHeading tagline={tagline} title={subject.data.name} description={subject.data.description} />

    <Separator />

    <Panel id="temas" title="Temas" count={temas.length}>
      {
        temas.length === 0 ? (
          <p class="p-4 text-muted-foreground">
            Todavía no hay temas publicados de esta asignatura. Cada tema entra cuando está estudiado y con los ejercicios hechos.
          </p>
        ) : (
          <ItemGrid>
            {temas.map((t) => (
              <li>
                <Card
                  href={`/${subject.id}/${t.data.slug}/teoria`}
                  number={String(t.data.number).padStart(2, '0')}
                  label={t.data.unit ?? `Tema ${t.data.number}`}
                  title={t.data.title}
                  description={t.data.description}
                  foot={docsOf(t.data.slug)}
                  color={subject.data.color}
                />
              </li>
            ))}
          </ItemGrid>
        )
      }
    </Panel>
  </div>
</Base>
