---
import Icon from '../../../components/Icon.astro';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { DOC_LABELS, docsOfTema, temaNumber } from '../../../data/content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => {
    const [subject, tema, kind] = doc.id.split('/');
    return { params: { subject, tema, doc: kind }, props: { doc } };
  });
}

const { doc } = Astro.props;
const subjectId = Astro.params.subject!;
const temaSlug = Astro.params.tema!;

const subject = (await getEntry('subjects', subjectId))!;
const tema = (await getCollection('temas')).find(
  (t) => t.data.subject === subjectId && t.data.slug === temaSlug,
)!;

const siblings = docsOfTema(await getCollection('docs'), subjectId, temaSlug);

const { Content, headings } = await render(doc);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const number = temaNumber(tema.data.number);
const downloadName = `${subjectId}-tema${number}-${doc.data.kind}.md`;
const pageTitle = `${tema.data.title} · ${doc.data.title}`;
const idx = siblings.findIndex((s) => s.id === doc.id);
const prev = siblings[idx - 1];
const next = siblings[idx + 1];
---

<Base title={pageTitle} description={tema.data.description} sidebar={false}>
  <!-- Cabecera en la columna central (DocContainer de chanhdai) -->
  <div class="mx-auto w-full border-x md:max-w-3xl">
    <div class="screen-line-bottom h-px"></div>

    <div class="flex items-center justify-between p-2 pl-4">
      <a href={`/${subjectId}`} class="press inline-flex h-7 items-center gap-2 text-sm tracking-wider text-muted-foreground hover:text-foreground">
        <Icon name="arrow-left" class="size-4" />
        {subject.data.name} · Tema {number}
      </a>
      <div class="flex items-center gap-2">
        {
          prev && (
            <a href={`/${subjectId}/${temaSlug}/${prev.data.kind}`} class="press-icon inline-flex size-7 items-center justify-center rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80" aria-label={`Anterior: ${DOC_LABELS[prev.data.kind]}`}>
              <Icon name="arrow-left" class="size-4" />
            </a>
          )
        }
        {
          next && (
            <a href={`/${subjectId}/${temaSlug}/${next.data.kind}`} class="press-icon inline-flex size-7 items-center justify-center rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80" aria-label={`Siguiente: ${DOC_LABELS[next.data.kind]}`}>
              <Icon name="arrow-right" class="size-4" />
            </a>
          )
        }
      </div>
    </div>

    <div class="screen-line-top screen-line-bottom py-px"><div class="h-4"></div></div>

    <h1 class="screen-line-bottom heading px-4 text-4xl text-balance">{tema.data.title}</h1>

    <!-- Pestañas del tema: Tabs de shadcn a lo ancho de la columna -->
    <div class="screen-line-bottom p-2">
      <nav class="flex h-9 w-full items-center rounded-lg bg-muted p-[3px] text-muted-foreground" aria-label="Documentos del tema">
        {
          siblings.map((s) => (
            <a
              href={`/${subjectId}/${temaSlug}/${s.data.kind}`}
              class:list={[
                'press inline-flex h-full flex-1 items-center justify-center rounded-md px-2 text-sm font-medium whitespace-nowrap',
                s.id === doc.id ? 'bg-background text-foreground shadow-sm dark:bg-input/30' : 'hover:text-foreground',
              ]}
              aria-current={s.id === doc.id ? 'page' : undefined}
            >
              {DOC_LABELS[s.data.kind]}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <div class="mx-auto w-full min-w-0 border-x md:max-w-3xl">
      <div class="prose prose-ncdai px-4 pt-8 pb-8">
        <p class="lead !mt-0 text-muted-foreground">{tema.data.description}</p>

        {
          toc.length > 0 && (
            <details class="toc-inline not-prose">
              <summary>En este documento · {toc.length} secciones</summary>
              <ol class="mt-1 mb-2 flex flex-col gap-1 px-3 text-sm">
                {toc.map((h) => (
                  <li class:list={[h.depth === 3 && 'pl-3']}>
                    <a href={`#${h.slug}`} class="text-muted-foreground transition-colors hover:text-foreground">{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        <div id="doc-content" class="doc-content">
          <Content />
        </div>
      </div>

      <!-- Lector paginado: una página por cada <h2> (ver rehype-sections.mjs). Sin JS no se
           muestra y el documento se lee entero. Al llegar al final, enlaza con el documento
           anterior o siguiente del tema. -->
      <nav id="doc-pager" class="doc-pager screen-line-top" aria-label="Páginas del documento" hidden>
        <div class="flex items-center gap-3 px-4 pt-3 pb-2 text-xs text-muted-foreground tabular-nums">
          <span class="shrink-0">Página <span data-pager-index>1</span> de <span data-pager-count>1</span></span>
          <span class="h-1 flex-1 overflow-hidden rounded-full bg-muted" aria-hidden="true">
            <span class="block h-full rounded-full bg-foreground/70 transition-[width] duration-300" data-pager-progress></span>
          </span>
        </div>
        <div class="grid grid-cols-2">
          <button type="button" class="pager-link press group/pager flex min-w-0 flex-col items-start gap-1 p-4 text-left hover:bg-accent-muted" data-pager="prev">
            <span class="flex items-center gap-1 text-xs text-muted-foreground"><Icon name="arrow-left" class="size-3.5" /> Anterior</span>
            <span class="heading line-clamp-2 text-lg leading-snug" data-pager-title></span>
          </button>
          <button type="button" class="pager-link press group/pager flex min-w-0 flex-col items-end gap-1 border-l p-4 text-right hover:bg-accent-muted" data-pager="next">
            <span class="flex items-center gap-1 text-xs text-muted-foreground">Siguiente <Icon name="arrow-right" class="size-3.5" /></span>
            <span class="heading line-clamp-2 text-lg leading-snug" data-pager-title></span>
          </button>
        </div>
      </nav>
      <script
        is:inline
        data-prev-doc={prev ? `/${subjectId}/${temaSlug}/${prev.data.kind}` : undefined}
        data-prev-doc-label={prev ? DOC_LABELS[prev.data.kind] : undefined}
        data-next-doc={next ? `/${subjectId}/${temaSlug}/${next.data.kind}` : undefined}
        data-next-doc-label={next ? DOC_LABELS[next.data.kind] : undefined}
      >
        // Se ejecuta en cada carga (también al navegar con ClientRouter) y antes de pintar:
        // deja visible solo la página que toca, sin parpadeo. Los eventos van en el <script>
        // de módulo de abajo.
        (() => {
          const docs = document.currentScript.dataset;
          const content = document.getElementById('doc-content');
          const pager = document.getElementById('doc-pager');

          // Agrupa el documento en <section class="doc-section">, una por <h2> con todo lo
          // que tiene debajo. Lo anterior al primer <h2> forma su propia página. Los <hr>
          // que separaban apartados sobran: ahora separa el cambio de página.
          const isBlank = (node) => node.nodeType === Node.TEXT_NODE && !node.textContent.trim();
          const groups = [];
          for (const node of [...content.childNodes]) {
            if (node.nodeName === 'H2' || groups.length === 0) {
              groups.push({ title: node.nodeName === 'H2' ? node.textContent.trim() : 'Introducción', nodes: [] });
            }
            if (node.nodeName !== 'HR') groups[groups.length - 1].nodes.push(node);
          }
          const pages = groups.filter((g) => g.nodes.some((node) => !isBlank(node)));
          // Con una sola página no hay lector: el documento se queda tal cual
          if (pages.length < 2) return;
          const sections = pages.map((g) => {
            const section = document.createElement('section');
            section.className = 'doc-section';
            section.dataset.title = g.title;
            section.append(...g.nodes);
            return section;
          });
          content.replaceChildren(...sections);

          const n = sections.length;
          let current = 0;
          const titleOf = (i) => sections[i].dataset.title;
          const hashOf = (i) => sections[i].querySelector('h2')?.id ?? '';

          function setButton(button, target, docHref, docLabel) {
            const title = button.querySelector('[data-pager-title]');
            if (target !== null) {
              button.hidden = false;
              button.dataset.target = String(target);
              delete button.dataset.href;
              title.textContent = titleOf(target);
            } else if (docHref) {
              button.hidden = false;
              delete button.dataset.target;
              button.dataset.href = docHref;
              title.textContent = docLabel;
            } else {
              button.hidden = true;
            }
          }

          function show(i) {
            current = Math.max(0, Math.min(n - 1, i));
            sections.forEach((s, k) => (s.hidden = k !== current));
            pager.querySelector('[data-pager-index]').textContent = String(current + 1);
            pager.querySelector('[data-pager-count]').textContent = String(n);
            pager.querySelector('[data-pager-progress]').style.width = `${((current + 1) / n) * 100}%`;
            setButton(pager.querySelector('[data-pager="prev"]'), current > 0 ? current - 1 : null, docs.prevDoc, docs.prevDocLabel);
            setButton(pager.querySelector('[data-pager="next"]'), current < n - 1 ? current + 1 : null, docs.nextDoc, docs.nextDocLabel);
            return current;
          }

          // Página que contiene un elemento (por su id); -1 si no está
          function indexOfId(id) {
            const el = id && document.getElementById(id);
            return el ? sections.findIndex((s) => s.contains(el)) : -1;
          }

          window.__docPager = { show, indexOfId, hashOf, current: () => current, count: n };
          content.dataset.paged = '';
          pager.hidden = false;
          const fromHash = indexOfId(decodeURIComponent(location.hash.slice(1)));
          show(fromHash < 0 ? 0 : fromHash);
        })();
      </script>

      <div class="screen-line-top screen-line-bottom p-4">
        <p class="mb-3 text-sm font-medium tracking-wider text-muted-foreground">Descargas</p>
        <div class="flex flex-wrap gap-2">
          <a
            href={`/${subjectId}/${temaSlug}/${doc.data.kind}.md`}
            download={downloadName}
            class="press inline-flex h-8 items-center gap-1.5 rounded-lg bg-primary px-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/80"
          >
            <Icon name="download" class="size-4" />
            {doc.data.title}.md
          </a>
          {
            tema.data.downloads.map((d) => (
              <a
                href={d.file}
                download
                class="press inline-flex h-8 items-center rounded-lg border bg-background px-2.5 font-mono text-sm shadow-xs hover:bg-muted dark:border-input dark:bg-input/30 dark:hover:bg-input/50"
              >
                {d.label}
              </a>
            ))
          }
        </div>
        {
          tema.data.downloads.length > 0 && (
            <p class="mt-3 text-sm text-muted-foreground">Mis soluciones: resueltas por mí y corregidas al final de cada fichero.</p>
          )
        }
      </div>
      <div class="h-4"></div>
  </div>

</Base>

<script>
  import { navigate } from 'astro:transitions/client';

  // Eventos del lector paginado. Módulo: se ejecuta una vez y escucha en el documento;
  // el estado de cada página lo deja el script inline (window.__docPager).
  interface DocPager {
    show(i: number): number;
    indexOfId(id: string): number;
    hashOf(i: number): string;
    current(): number;
    count: number;
  }
  const pager = () => (window as unknown as { __docPager?: DocPager }).__docPager;

  // Arriba del contenido, por debajo de la barra fija
  function scrollToContent() {
    const content = document.getElementById('doc-content');
    if (!content) return;
    const top = content.getBoundingClientRect().top + window.scrollY - 80;
    window.scrollTo({ top: Math.max(0, top), behavior: 'instant' });
  }

  function go(i: number) {
    const p = pager();
    if (!p) return;
    const shown = p.show(i);
    const hash = shown === 0 ? '' : `#${p.hashOf(shown)}`;
    history.replaceState(history.state, '', `${location.pathname}${hash}`);
    scrollToContent();
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const button = target.closest<HTMLButtonElement>('[data-pager]');
    if (button) {
      if (button.dataset.href) navigate(button.dataset.href);
      else if (button.dataset.target) go(Number(button.dataset.target));
      return;
    }

    // Enlaces internos (índice, referencias): abrir la página que contiene el destino
    const link = target.closest<HTMLAnchorElement>('a[href^="#"]');
    const p = pager();
    if (!link || !p) return;
    const id = decodeURIComponent(link.getAttribute('href')!.slice(1));
    const index = p.indexOfId(id);
    if (index < 0) return;
    event.preventDefault();
    p.show(index);
    history.replaceState(history.state, '', `${location.pathname}#${id}`);
    document.getElementById(id)?.scrollIntoView();
  });

  // Flechas del teclado, salvo escribiendo o con un diálogo abierto
  document.addEventListener('keydown', (event) => {
    const p = pager();
    if (!p || event.metaKey || event.ctrlKey || event.altKey) return;
    if ((event.target as HTMLElement).closest('input, textarea, select, [contenteditable="true"], dialog[open]')) return;
    if (event.key === 'ArrowRight' && p.current() < p.count - 1) go(p.current() + 1);
    if (event.key === 'ArrowLeft' && p.current() > 0) go(p.current() - 1);
  });

  // Al salir de la página, el lector deja de existir
  document.addEventListener('astro:before-swap', () => {
    delete (window as unknown as { __docPager?: DocPager }).__docPager;
  });
</script>

<style>
  .doc-pager [hidden] {
    display: none;
  }

  /* Si solo queda el botón de "siguiente", que no se quede en la columna derecha a medias */
  .doc-pager [data-pager='prev'][hidden] + [data-pager='next'] {
    grid-column: 2;
  }

  .toc-inline {
    margin-top: 1.25em;
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--border) 64%, transparent);
    padding: 0.25rem;
  }

  .toc-inline > summary {
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }
</style>
