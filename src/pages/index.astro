---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CollectionView from '../components/CollectionView.astro';
import CollectionTools from '../components/CollectionTools.astro';
import Panel from '../components/Panel.astro';

const subjects = (await getCollection('subjects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const temas = await getCollection('temas');

const temaCount = (subjectId: string) =>
  temas.filter((t) => t.data.subject === subjectId).length;

const foot = (subjectId: string) => {
  const n = temaCount(subjectId);
  if (n === 0) return 'Sin temas todavía';
  return `${n} ${n === 1 ? 'tema' : 'temas'}`;
};

---

<Base title="estudiodaw.dev" crumbs={[{ label: 'Inicio' }]}>
  <div class="mx-auto md:max-w-3xl">
    <Panel id="asignaturas" title="Asignaturas" count={subjects.length}>
      <CollectionTools slot="actions" placeholder="Buscar asignatura…" />
      <CollectionView
        items={subjects.map((s) => ({
          href: `/${s.id}`,
          subject: s.id,
          label: s.data.year === 1 ? 'Pendiente de 1º' : '2º curso',
          title: s.data.name,
          description: s.data.description,
          foot: foot(s.id),
          color: s.data.color,
        }))}
      />
    </Panel>

  </div>
</Base>
