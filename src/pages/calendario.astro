---
/**
 * @file Calendario de exámenes: todos los parciales y finales del curso, por meses, con cuenta
 * atrás, filtro por curso y descarga en .ics (scripts/calendar.ts).
 *
 * @author Alberto Cantero
 * @license MIT
 */
import { getCollection } from 'astro:content';
import PageHeading from '../components/page/PageHeading.astro';
import Panel from '../components/page/Panel.astro';
import Separator from '../components/page/Separator.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import HoverCard from '../components/ui/HoverCard.astro';
import Icon from '../components/ui/Icon.astro';
import SegmentedControl from '../components/ui/SegmentedControl.astro';
import { COURSES, COURSE_YEARS } from '../data/courses';
import { exams } from '../data/exams';
import { ACADEMIC_YEAR } from '../data/site';
import Base from '../layouts/Base.astro';
import { temaHref } from '../lib/content';
import { examDate, examUnits, groupExamsByDay, groupExamsByMonth } from '../lib/exams';

// Unidad del temario → sus apuntes, si ya están publicados (por el campo unit del tema: "UD3")
const docs = await getCollection('docs');
const temaByUnit = new Map(
  (await getCollection('temas'))
    .filter((tema) => tema.data.unit)
    .map((tema) => [`${tema.data.subject}/${tema.data.unit}`, tema]),
);

/**
 * Dirección de los apuntes de una unidad.
 *
 * @param subject Id de la asignatura.
 * @param n Número de la unidad.
 * @returns La dirección, o undefined si aún no tiene apuntes publicados.
 */
function unitHref(subject: string, n: number): string | undefined {
  const tema = temaByUnit.get(`${subject}/UD${n}`);
  return tema && temaHref(tema, docs);
}

const subjects = new Map(
  (await getCollection('subjects')).map((subject) => [subject.id, subject.data]),
);

// Cada examen tiene que ser de una asignatura con página: si no, se para la build
const orphan = exams.find((exam) => !subjects.has(exam.subject));
if (orphan) throw new Error(`Examen de "${orphan.subject}", que no está en src/content/subjects`);

const months = groupExamsByMonth(exams);
const courseFilters = [
  { value: 'all', label: 'Todos', tooltip: 'Ver los exámenes de los dos cursos' },
  ...COURSE_YEARS.map((year) => ({
    value: String(year),
    label: COURSES[year].name,
    tooltip: `Ver solo los exámenes del ${COURSES[year].title.toLowerCase()}`,
  })),
];
---

<Base
  title="Calendario de exámenes"
  description={`Parciales y finales de DAW a distancia, curso ${ACADEMIC_YEAR}.`}
  banner={false}
>
  <PageHeading
    breadcrumbs={[{ label: `Curso ${ACADEMIC_YEAR} · Presenciales` }]}
    title="Calendario de exámenes"
    description="Parciales y finales de 1.º y 2.º de DAW, con las dos convocatorias. Todas las horas son peninsulares; los exámenes ya pasados quedan atenuados."
  >
    <div class="dash-b flex flex-wrap items-center justify-between gap-2 px-gutter py-3">
      <SegmentedControl name="exam-course" label="Curso" options={courseFilters} />
      <Button
        variant="outline"
        tooltip="Descargar los exámenes en un .ics para tu calendario"
        data-exam-ics
      >
        <Icon name="calendar-plus" class="size-4" />
        Añadir a mi calendario
      </Button>
    </div>
  </PageHeading>

  {months.map((month, index) => (
    <div data-subject-group>
      <Separator />
      <Panel
        id={`mes-${index + 1}`}
        title={month.title}
        count={month.exams.length}
        countNoun={{ one: 'examen', other: 'exámenes' }}
      >
        <ol class="hover-group">
          {groupExamsByDay(month.exams).map((day) => {
            const date = examDate(day[0]);
            return (
              // Un día: la fecha y su raya una sola vez, y sus exámenes uno debajo de otro. Si se
              // ocultan todos (filtro de curso, matrícula), se oculta el día (data-subject-group)
              <li class="exam-day dash-b flex px-gutter py-inset" data-subject-group>
                <div class="exam-date ml-surface flex w-10 shrink-0 flex-col items-center py-3 leading-none">
                  <span class="font-mono text-xl font-medium tabular-nums">{date.day}</span>
                  <span class="eyebrow mt-1 text-muted-foreground">{date.weekday}</span>
                </div>
                <span class="exam-date my-3 ml-4 w-px shrink-0 bg-border" aria-hidden="true" />
                <ul class="ml-2 min-w-0 flex-1">
                  {day.map((exam) => {
                    const subject = subjects.get(exam.subject);
                    const units = examUnits(exam);
                    return (
                      <li
                        class="transition-opacity data-past:opacity-45"
                        data-exam
                        data-start={exam.start}
                        data-end={exam.end}
                        data-course={exam.course}
                        data-title={subject?.name}
                        data-label={exam.label}
                        data-subject={exam.subject}
                        data-count-item
                      >
                        {/* Como las filas de la lista de la portada: toda la fila se sombrea al
                            pasar y lleva a la asignatura (la capa del enlace la cubre entera,
                            como en Card). Separada de la raya del día (ml-2 en la lista) y con
                            menos relleno a ese lado, para que el texto no se aleje de ella */}
                        <div class="group/row relative flex items-center gap-4 rounded-xl py-3 pr-surface pl-2 surface-interactive">
                          <div class="min-w-0 flex-1">
                            <p class="flex items-center gap-2 font-medium">
                              <a
                                href={`/${exam.subject}`}
                                class="truncate outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-transparent"
                              >
                                <span
                                  class="absolute inset-0 rounded-xl group-has-[a:focus-visible]/row:shadow-(--focus-ring)"
                                  aria-hidden="true"
                                />
                                {subject?.name}
                              </a>
                            </p>
                            <p class="mt-1 flex flex-wrap items-center gap-1.5">
                              <Badge text={exam.label} />
                              <Badge text={examDate(exam).time} />
                              <Badge
                                text={COURSES[exam.course].name}
                                dot={COURSES[exam.course].dot}
                                tooltip={`Este examen es del ${COURSES[exam.course].title.toLowerCase()}`}
                              />
                            </p>
                          </div>
                          <div class="flex shrink-0 flex-col items-end gap-1.5">
                            <span
                              class="rounded-md border bg-muted/50 px-1.5 py-0.5 font-mono text-xs text-muted-foreground tabular-nums"
                              data-exam-countdown
                            />
                            <HoverCard>
                              <button
                                type="button"
                                class="focus-ring relative z-1 rounded-sm text-xs whitespace-nowrap text-muted-foreground link-underline decoration-transparent"
                                aria-expanded="false"
                              >
                                ¿Qué unidades entran?
                              </button>
                              <div slot="content">
                                {units?.items.length ? (
                                  <ul>
                                    {units.items.map((unit) => {
                                      const href = unitHref(exam.subject, unit.n);
                                      const label = (
                                        <>
                                          <span class="block text-xs">Unidad {unit.n}</span>
                                          <span class="block">{unit.title}</span>
                                        </>
                                      );
                                      return (
                                        // Entre unidad y unidad, la línea discontinua de la web (dash-b)
                                        <li class="dash-b py-2 first:pt-0 last:pb-0 last:[--dash-bottom:none]">
                                          {/* Con apuntes, enlace a ellos; sin apuntes, botón desactivado */}
                                          {href ? (
                                            <a
                                              href={href}
                                              class="focus-ring block rounded-sm text-foreground link-underline"
                                            >
                                              {label}
                                            </a>
                                          ) : (
                                            <button
                                              type="button"
                                              class="block cursor-not-allowed text-left text-muted-foreground"
                                              disabled
                                            >
                                              {label}
                                            </button>
                                          )}
                                        </li>
                                      );
                                    })}
                                  </ul>
                                ) : (
                                  <p class="text-muted-foreground">
                                    {units?.summary ??
                                      'Aún no se sabe qué unidades entran en este examen.'}
                                  </p>
                                )}
                              </div>
                            </HoverCard>
                          </div>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </li>
            );
          })}
        </ol>
      </Panel>
    </div>
  ))}

  <p class="p-gutter text-sm text-muted-foreground" role="status" data-groups-empty hidden>
    Ningún examen con este filtro y tu matrícula.
  </p>
</Base>

<script>
  import '../scripts/calendar';
</script>

<style>
  /* Un día con todos sus exámenes ya pasados: la fecha y su raya, atenuadas como ellos */
  .exam-day:not(:has([data-exam]:not([data-past]))) .exam-date {
    opacity: 0.45;
  }
</style>
