---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHeading from '../components/PageHeading.astro';
import Panel from '../components/Panel.astro';
import Separator from '../components/Separator.astro';
import { exams } from '../data/exams';
import { COURSE_LABELS, otherModules } from '../data/modules';

const subjects = await getCollection('subjects');
const byId = new Map(subjects.map((s) => [s.id, s.data]));

const TZ = 'Europe/Madrid';
const monthKey = new Intl.DateTimeFormat('es-ES', { year: 'numeric', month: '2-digit', timeZone: TZ });
const monthName = new Intl.DateTimeFormat('es-ES', { month: 'long', year: 'numeric', timeZone: TZ });
const dayNum = new Intl.DateTimeFormat('es-ES', { day: 'numeric', timeZone: TZ });
const weekday = new Intl.DateTimeFormat('es-ES', { weekday: 'short', timeZone: TZ });
const time = new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: TZ });

// Agrupado por mes, en orden
const sorted = [...exams].sort((a, b) => a.start.localeCompare(b.start) || String(a.course).localeCompare(String(b.course)));
const months = new Map<string, { title: string; items: typeof sorted }>();
for (const e of sorted) {
  const d = new Date(e.start);
  const key = monthKey.format(d);
  if (!months.has(key)) {
    const t = monthName.format(d);
    months.set(key, { title: t.charAt(0).toUpperCase() + t.slice(1), items: [] });
  }
  months.get(key)!.items.push(e);
}
const groups = [...months.values()];

const courseFilters = [
  { value: 'all', label: 'Todos' },
  { value: '1', label: '1º' },
  { value: '2', label: '2º' },
  { value: 'loe', label: 'LOE' },
];
---

<Base
  title="Calendario de exámenes"
  description="Parciales y finales de DAW a distancia, curso 2026-27."
  crumbs={[{ label: 'Inicio', href: '/' }, { label: 'Calendario' }]}
  banner={false}
>
  <div class="mx-auto md:max-w-3xl">
    <PageHeading
      tagline="Curso 2026-27 · Presenciales"
      title="Calendario de exámenes"
      description="Parciales y finales de 1º y 2º de DAW, con las dos convocatorias, y los finales del plan LOE. Todas las horas son peninsulares; los exámenes ya pasados quedan atenuados."
    >
      <div class="screen-line-bottom flex flex-wrap items-center justify-between gap-2 px-4 py-3">
        <div class="flex items-center gap-0.5 rounded-lg bg-muted p-0.5" role="group" aria-label="Curso">
          {
            courseFilters.map((f) => (
              <button type="button" class="segment-option press h-7 rounded-md px-2.5 text-ui text-muted-foreground" data-exam-course={f.value}>
                {f.label}
              </button>
            ))
          }
        </div>
        <button
          type="button"
          class="exam-ics press inline-flex h-8 items-center gap-1.5 rounded-lg border px-2.5 text-ui font-medium hover:bg-muted"
        >
          <Icon name="calendar-plus" class="size-4" />
          Añadir a mi calendario
        </button>
      </div>
    </PageHeading>

    {
      groups.map((g, gi) => (
        <div data-subject-group>
          <Separator />
          <Panel id={`mes-${gi}`} title={g.title} count={g.items.length}>
            <ol>
              {g.items.map((e) => {
                const page = byId.get(e.subject);
                const s = page ?? otherModules[e.subject];
                const d = new Date(e.start);
                return (
                  <li
                    class="exam-row screen-line-bottom flex items-center gap-4 px-4 py-3 transition-opacity"
                    data-start={e.start}
                    data-end={e.end}
                    data-course={e.course}
                    data-title={s?.name ?? e.subject}
                    data-label={e.label}
                    data-subject={e.course === 'loe' ? `loe-${e.subject}` : e.subject}
                    data-count-item
                  >
                    <div class="flex w-10 shrink-0 flex-col items-center leading-none">
                      <span class="font-mono text-xl font-medium tabular-nums">{dayNum.format(d)}</span>
                      <span class="mt-1 text-[0.625rem] tracking-wider text-muted-foreground uppercase">{weekday.format(d).replace('.', '')}</span>
                    </div>
                    <span class="h-8 w-px shrink-0 bg-border" aria-hidden="true" />
                    <div class="min-w-0 flex-1">
                      <p class="flex items-center gap-2 font-medium">
                        <span class="size-2 shrink-0 rounded-full" style={`background:${s?.color}`} aria-hidden="true" />
                        {page ? (
                          <a href={`/${e.subject}`} class="truncate hover:underline hover:decoration-current/30 hover:underline-offset-3">{s.name}</a>
                        ) : (
                          <span class="truncate">{s?.name ?? e.subject}</span>
                        )}
                      </p>
                      <p class="flex items-center gap-2 text-sm text-muted-foreground tabular-nums">
                        <span>{e.label}</span>
                        <span class="h-3.5 w-px bg-border" aria-hidden="true" />
                        <span>{time.format(d)}–{time.format(new Date(e.end))}</span>
                        <span class="h-3.5 w-px bg-border max-sm:hidden" aria-hidden="true" />
                        <span class="max-sm:hidden">{COURSE_LABELS[e.course]}</span>
                      </p>
                    </div>
                    <span class="exam-countdown shrink-0 rounded-md border bg-muted/50 px-1.5 py-0.5 font-mono text-xs tabular-nums text-muted-foreground" />
                  </li>
                );
              })}
            </ol>
          </Panel>
        </div>
      ))
    }

    <p class="border-x p-4 text-sm text-muted-foreground" data-groups-empty hidden>
      Ningún examen con este filtro y tu matrícula.
    </p>
  </div>
</Base>

<script>
  import { STORAGE_KEYS } from '../data/storage';
  import { buildIcs } from '../scripts/ics';
  import { isShown, refreshLists } from '../scripts/visibility';

  const DAY = 24 * 60 * 60 * 1000;
  const rows = () => [...document.querySelectorAll<HTMLLIElement>('.exam-row')];

  // Día del calendario en Madrid como número de días desde 1970: la cuenta atrás va por
  // días naturales ("Mañana" es mañana aunque falten menos de 24 horas).
  const madridDate = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid', year: 'numeric', month: '2-digit', day: '2-digit' });
  const dayNumber = (t: number) => Date.parse(`${madridDate.format(t)}T00:00:00Z`) / DAY;

  function countdown(now: number, start: number, end: number) {
    if (now >= end) return 'Hecho';
    if (now >= start) return 'En curso';
    const days = dayNumber(start) - dayNumber(now);
    if (days === 0) return 'Hoy';
    if (days === 1) return 'Mañana';
    return `${days} días`;
  }

  function refreshCountdown() {
    const now = Date.now();
    rows().forEach((row) => {
      const start = Date.parse(row.dataset.start!);
      const end = Date.parse(row.dataset.end!);
      row.classList.toggle('opacity-45', now >= end);
      const badge = row.querySelector<HTMLElement>('.exam-countdown');
      if (badge) badge.textContent = countdown(now, start, end);
    });
  }

  // Filtro por curso: se recuerda en el navegador
  function readCourse() {
    try {
      return localStorage.getItem(STORAGE_KEYS.examCourse) ?? 'all';
    } catch {
      return 'all';
    }
  }

  function applyCourse(course: string) {
    rows().forEach((row) => {
      row.hidden = course !== 'all' && row.dataset.course !== course;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-exam-course]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.examCourse === course));
    });
    refreshLists();
  }

  // .ics con lo que se ve (filtro y matrícula) que aún no ha pasado
  function downloadIcs() {
    const now = Date.now();
    const events = rows()
      .filter((row) => isShown(row) && Date.parse(row.dataset.end!) > now)
      .map((row) => ({
        uid: `${row.dataset.subject}-${row.dataset.start}`,
        title: `Examen: ${row.dataset.title} (${row.dataset.label})`,
        description: `DAW a distancia, CIFP de Ponferrada. ${row.dataset.label}.`,
        start: row.dataset.start!,
        end: row.dataset.end!,
      }));
    const blob = new Blob([buildIcs(events, 'Exámenes DAW 2026-27')], { type: 'text/calendar;charset=utf-8' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'examenes-daw-2026-27.ics';
    link.click();
    URL.revokeObjectURL(link.href);
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const option = target.closest<HTMLButtonElement>('[data-exam-course]');
    if (option) {
      const course = option.dataset.examCourse!;
      try {
        localStorage.setItem(STORAGE_KEYS.examCourse, course);
      } catch {}
      applyCourse(course);
      return;
    }
    if (target.closest('.exam-ics')) downloadIcs();
  });

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.exam-row')) return;
    refreshCountdown();
    applyCourse(readCourse());
  });

  // Con la página abierta de un día para otro la cuenta sigue al día. Un solo intervalo
  // para toda la sesión: el script de módulo se ejecuta una vez aunque se navegue.
  setInterval(refreshCountdown, 60_000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refreshCountdown();
  });
</script>
