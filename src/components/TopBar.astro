---
// Barra superior de la columna del cuerpo, como la data-catalogue-bar de designeer.xyz:
// fija arriba al hacer scroll, línea discontinua debajo, navegación a la izquierda y
// acciones a la derecha. Solo en escritorio y en las páginas con panel lateral.
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { GITHUB_URL, isSectionActive, normalizePath, sectionLinks } from '../data/site';

// Las migas se muestran en otro sitio; el tipo se sigue exportando para Base.
export interface Crumb {
  label: string;
  href?: string;
}

const path = normalizePath(Astro.url.pathname);
const isActive = (href: string) => isSectionActive(path, href);
---

<div class="sticky top-0 z-30 flex items-center justify-between gap-3 border-b border-dashed bg-background px-[1.125rem] py-2.5 max-lg:hidden">
  <nav aria-label="Secciones">
    <ul class="flex items-center gap-1">
      {
        sectionLinks.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[
                'press flex h-8 items-center rounded-lg px-2 text-ui hover:bg-muted',
                isActive(l.href) ? 'font-medium text-foreground' : 'text-muted-foreground hover:text-foreground',
              ]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="ml-auto flex items-center gap-1">
    <button
      type="button"
      class="group/enroll press flex h-8 items-center gap-1.5 rounded-lg px-2 text-ui text-muted-foreground hover:bg-muted hover:text-foreground data-active:text-foreground"
      data-enrollment-open
      aria-haspopup="dialog"
    >
      <Icon name="school" class="size-4" />
      Mi matrícula
      <span class="hidden size-1.5 rounded-full bg-accent-ink group-data-active/enroll:block" aria-hidden="true"></span>
    </button>
    <a
      href={GITHUB_URL}
      class="press-icon grid size-8 place-items-center rounded-lg text-muted-foreground hover:bg-muted hover:text-foreground"
      aria-label="Código en GitHub"
    >
      <Icon name="brand-github" class="size-4" />
    </a>
    <ThemeToggle />
  </div>
</div>
