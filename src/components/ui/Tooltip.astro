---
/**
 * @file Tooltip: lo llevan los controles y los enlaces (lo que hará el clic) y las
 * insignias (lo que significan). Aparece al dejar el ratón encima un momento (--delay-tooltip) o al
 * llegar con el teclado, sin espera (:focus-visible; tras un clic con el ratón, no). Al salir, al
 * pulsar o con Esc, se va. En pantallas táctiles, tocar ya lo cierra (scripts/tooltip.ts).
 *
 * Va en la capa superior del navegador (popover="manual"): por encima de todo, sin que lo
 * recorte ni lo tape ningún contenedor (la columna, el scroll del panel lateral, el cuerpo
 * junto al panel, un desplegable o un diálogo). scripts/tooltip.ts lo abre la primera vez que
 * entran el ratón o el foco (data-open) y lo coloca (scripts/floating.ts): a su lado (side),
 * centrado con el elemento y metido en la ventana; si arriba no cabe, debajo. Mostrarlo, la
 * espera y el fundido son CSS. Sin texto (ni content ni el slot "content"), no hay tooltip: solo
 * el elemento.
 *
 * El envoltorio no ocupa caja (display: contents): se pone alrededor de cualquier elemento sin
 * cambiar la maquetación. El elemento es su primer hijo.
 *
 * Es solo visual (aria-hidden): quien lo pone se encarga de que el lector de pantalla tenga lo
 * mismo, con el nombre accesible del elemento, con su rol ("Ir a…" en un enlace) o con un texto
 * sr-only (las insignias). Cumple WCAG 1.4.13: se puede pasar el ratón por encima sin que se
 * cierre y se cierra con Esc.
 *
 * @author Alberto Cantero
 * @license MIT
 */
import type { FloatingSide } from '../../scripts/floating';

interface Props {
  /** Texto del tooltip. Con el slot "content", el texto lo pone el slot */
  content?: string;
  /** Lado del elemento en el que sale */
  side?: FloatingSide;
  /** Sin la espera del ratón: para etiquetas que se leen de pasada (las pastillas del stack) */
  instant?: boolean;
  /** Atajo de teclado, en una tecla al lado del texto */
  shortcut?: string;
}

const { content, side = 'top', instant = false, shortcut } = Astro.props;
const hasText = Boolean(content) || Astro.slots.has('content');
---

{!hasText ? (
  <slot />
) : (
  <span class="tooltip" data-tooltip data-instant={instant ? '' : undefined}>
    <slot />
    <span
      class="tooltip-content"
      popover="manual"
      data-side={side}
      data-tooltip-content
      aria-hidden="true"
    >
      <slot name="content">{content}</slot>
      {shortcut && <kbd class="tooltip-kbd">{shortcut}</kbd>}
      <span class="tooltip-arrow" />
    </span>
  </span>
)}

<style>
  .tooltip {
    display: contents;
  }

  /* --tooltip-arrow-x / -y: dónde cae el centro del elemento en el tooltip, para la flecha (los
     pone el script). El hueco con el elemento es --floating-gap (tokens.css). */
  .tooltip-content {
    --tooltip-arrow-size: calc(var(--spacing) * 2.5);
    --tooltip-shift: calc(var(--spacing) * 2);
    /* Lo de serie de un popover, fuera: lo coloca el script y la flecha asoma por fuera */
    position: fixed;
    inset: auto;
    top: 0;
    left: 0;
    margin: 0;
    border: 0;
    overflow: visible;
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    width: max-content;
    max-width: var(--container-xs);
    border-radius: var(--radius-md);
    background: var(--foreground);
    padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 3);
    color: var(--background);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: var(--text-xs--line-height);
    letter-spacing: normal;
    text-align: left;
    text-transform: none;
    /* pretty y no balance: balance iguala las líneas pero la caja no encoge con ellas, y
       sobra hueco a la derecha */
    text-wrap: pretty;
    white-space: normal;
    /* Escondido (también mientras se desvanece) no atrapa clics: lo de debajo los recibe */
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    scale: 0.95;
    transition-property: opacity, translate, scale, visibility;
    transition-duration: var(--duration-ui);
    transition-timing-function: var(--ease-hover);
  }

  /* Cerrado, fuera de la página (lo que haría el navegador con un popover cerrado, y que el
     display: flex de arriba pisa): si no, ocupa sitio dentro de su contenedor */
  .tooltip-content:not(:popover-open) {
    display: none;
  }

  /* De dónde viene al aparecer y desde dónde crece: desde el elemento */
  .tooltip-content[data-side='top'] {
    translate: 0 var(--tooltip-shift);
    transform-origin: var(--tooltip-arrow-x, 50%) 100%;
  }

  .tooltip-content[data-side='bottom'] {
    translate: 0 calc(-1 * var(--tooltip-shift));
    transform-origin: var(--tooltip-arrow-x, 50%) 0;
  }

  .tooltip-content[data-side='right'] {
    translate: calc(-1 * var(--tooltip-shift)) 0;
    transform-origin: 0 var(--tooltip-arrow-y, 50%);
  }

  /* Puente invisible sobre el hueco: el ratón pasa del elemento al tooltip sin cerrarlo */
  .tooltip-content::after {
    content: '';
    position: absolute;
  }

  .tooltip-content[data-side='top']::after {
    inset-inline: 0;
    top: 100%;
    height: var(--floating-gap);
  }

  .tooltip-content[data-side='bottom']::after {
    inset-inline: 0;
    bottom: 100%;
    height: var(--floating-gap);
  }

  .tooltip-content[data-side='right']::after {
    inset-block: 0;
    right: 100%;
    width: var(--floating-gap);
  }

  /* Visible: con el ratón encima o el foco de teclado. Nunca cerrado a mano (Esc, clic o
     toque) ni con el menú del elemento abierto */
  .tooltip:is(:hover, :has(:focus-visible)):not([data-tooltip-dismissed]):not(
      :has([aria-expanded='true'])
    )
    > .tooltip-content[data-open] {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }

  /* Con el ratón (y sin foco de teclado), la espera antes de aparecer; al irse, ninguna. Sin
     espera si se viene de otro tooltip (html[data-tooltip-warm], scripts/tooltip.ts) */
  :global(:root:not([data-tooltip-warm]))
    .tooltip:not([data-instant]):hover:not(:has(:focus-visible))
    > .tooltip-content {
    transition-delay: var(--delay-tooltip);
  }

  /* Tecla del atajo */
  .tooltip-kbd {
    border: 1px solid color-mix(in oklab, currentColor 25%, transparent);
    border-radius: var(--radius-xs);
    padding-inline: 0.3em;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: 1.5;
    opacity: 0.7;
  }

  /* Flecha: un cuadrado girado 45° que asoma por el lado del elemento, a su centro */
  .tooltip-arrow {
    position: absolute;
    width: var(--tooltip-arrow-size);
    height: var(--tooltip-arrow-size);
    border-radius: calc(var(--radius-xs) / 2);
    background: inherit;
  }

  [data-side='top'] > .tooltip-arrow {
    top: 100%;
    left: var(--tooltip-arrow-x, 50%);
    translate: -50% 0;
    transform: translateY(calc(-50% - 2px)) rotate(45deg);
  }

  [data-side='bottom'] > .tooltip-arrow {
    bottom: 100%;
    left: var(--tooltip-arrow-x, 50%);
    translate: -50% 0;
    transform: translateY(calc(50% + 2px)) rotate(45deg);
  }

  [data-side='right'] > .tooltip-arrow {
    top: var(--tooltip-arrow-y, 50%);
    right: 100%;
    translate: 0 -50%;
    transform: translateX(calc(50% + 2px)) rotate(45deg);
  }

  /* En oscuro no se invierte a blanco: gris de popover con borde (también en la flecha, en
     los dos lados que asoman) */
  :global(.dark) .tooltip-content {
    border: 1px solid var(--popover-border);
    background-color: var(--popover);
    color: var(--popover-foreground);
  }

  :global(.dark) [data-side='top'] > .tooltip-arrow {
    border-right: 1px solid var(--popover-border);
    border-bottom: 1px solid var(--popover-border);
    border-radius: 0 0 calc(var(--radius-xs) / 2) 0;
    transform: translateY(calc(-50% - 0.5px)) rotate(45deg);
  }

  :global(.dark) [data-side='bottom'] > .tooltip-arrow {
    border-top: 1px solid var(--popover-border);
    border-left: 1px solid var(--popover-border);
    border-radius: calc(var(--radius-xs) / 2) 0 0 0;
    transform: translateY(calc(50% + 0.5px)) rotate(45deg);
  }

  :global(.dark) [data-side='right'] > .tooltip-arrow {
    border-bottom: 1px solid var(--popover-border);
    border-left: 1px solid var(--popover-border);
    border-radius: 0 0 0 calc(var(--radius-xs) / 2);
    transform: translateX(calc(50% + 0.5px)) rotate(45deg);
  }
</style>

<script>
  import '../../scripts/tooltip';
</script>
