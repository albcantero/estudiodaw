---
/**
 * @file Avatar: un círculo con la inicial del nombre o con un icono, sobre gris o sobre un color.
 * Tres tamaños: sm (24 px), default (32 px) y lg (40 px); en el pequeño, la letra y el icono
 * también son más pequeños. Encima lleva un borde fino que se funde con lo que tiene detrás (más
 * oscuro en claro y más claro en oscuro), para que el círculo se distinga sobre cualquier fondo.
 *
 * Trae todos los iconos que se pueden elegir (data/avatar.ts), ocultos: el script de la cuenta
 * (scripts/auth/avatar.ts) enseña el elegido, escribe la inicial y pone el color. Editable, trae
 * además un lápiz (edit-circle), oculto, que enseña quien lo usa al pasar el ratón.
 *
 * @author Alberto Cantero
 * @license MIT
 */
import { AVATAR_ICONS } from '../../data/avatar';
import { cn } from '../../lib/cn';
import Icon from './Icon.astro';

interface Props {
  size?: 'sm' | 'default' | 'lg';
  /** Con el lápiz de editar, oculto ([data-avatar-pencil]) */
  editable?: boolean;
  class?: string;
}

const { size = 'default', editable = false, class: className } = Astro.props;

/** Lado del círculo por tamaño */
const SIZES = { sm: 'size-6', default: 'size-8', lg: 'size-10' };
/** Tamaño del icono por tamaño del círculo */
const ICON_SIZES = { sm: 'size-3.5', default: 'size-4.5', lg: 'size-5' };
---

<span
  class={cn('avatar relative flex shrink-0 rounded-full select-none', SIZES[size], className)}
  data-size={size}
  aria-hidden="true"
  data-avatar
>
  <span
    class:list={[
      'flex size-full items-center justify-center rounded-full bg-muted font-medium text-muted-foreground uppercase',
      size === 'sm' ? 'text-xs' : 'text-sm',
    ]}
    data-avatar-fill
  >
    <span data-avatar-initial></span>
    {AVATAR_ICONS.map((icon) => (
      <span class="flex" hidden data-avatar-icon={icon.id}>
        <Icon name={icon.id} class={ICON_SIZES[size]} />
      </span>
    ))}
    {editable && (
      <span class="avatar-pencil" data-avatar-pencil>
        <Icon name="edit-circle" class={ICON_SIZES[size]} />
      </span>
    )}
  </span>
</span>

<style>
  /* El borde fino, por encima del fondo: se oscurece en claro y se aclara en oscuro */
  .avatar::after {
    position: absolute;
    inset: 0;
    border: 1px solid var(--border);
    border-radius: 9999px;
    content: '';
    mix-blend-mode: darken;
  }

  :global(.dark) .avatar::after {
    mix-blend-mode: lighten;
  }

  .avatar-pencil {
    display: none;
  }
</style>
