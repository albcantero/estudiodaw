---
// Badge de shadcn/ui (variantes default, secondary y outline), en Astro. Con `dot`, lleva
// delante un punto de color: la badge se queda neutra y el color lo da solo el punto.
// Con `icon`, un icono de Tabler en su lugar.
import Icon from './Icon.astro';

export type BadgeVariant = 'default' | 'secondary' | 'outline';
export type BadgeDot = 'green' | 'purple' | 'amber' | 'gray';

export interface BadgeData {
  text: string;
  variant?: BadgeVariant;
  dot?: BadgeDot;
  icon?: string;
}

interface Props {
  variant?: BadgeVariant;
  dot?: BadgeDot;
  icon?: string;
  class?: string;
}

const { variant = 'default', dot, icon, class: className } = Astro.props;

const variants = {
  default: 'border-transparent bg-primary text-primary-foreground',
  secondary: 'border-transparent bg-secondary text-secondary-foreground',
  outline: 'text-muted-foreground',
};

const dots = {
  green: 'bg-green-500',
  purple: 'bg-purple-500',
  amber: 'bg-amber-500',
  gray: 'bg-muted-foreground/40',
};
---

<span
  class:list={[
    'inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1.5 overflow-hidden rounded-md border px-2 text-xs leading-none font-medium whitespace-nowrap',
    variants[variant],
    className,
  ]}
>
  {icon && <Icon name={icon} class="size-3" />}
  {dot && <span class:list={['size-1.5 shrink-0 rounded-full', dots[dot]]} aria-hidden="true" />}
  <slot />
</span>
