---
import { getCollection } from 'astro:content';

// En la barra solo van las asignaturas con algún tema publicado; el resto, desde la home.
const temas = await getCollection('temas');
const published = new Set(temas.map((t) => t.data.subject));
const subjects = (await getCollection('subjects'))
  .filter((s) => published.has(s.id))
  .sort((a, b) => a.data.order - b.data.order);
const { class: className } = Astro.props;
const current = Astro.url.pathname.split('/')[1];
---

<header class:list={['sticky top-0 z-50 max-w-screen overflow-x-clip bg-background px-2 lg:px-0', className]}>
  <div class="screen-line-top screen-line-bottom screen-line-strong mx-auto flex h-(--header-height) items-center gap-2 border-x pr-2 pl-4 after:z-1 sm:gap-4 md:max-w-3xl">
    <a href="/" class="flex items-baseline text-[15px] font-medium tracking-tight" aria-label="Inicio">
      <span>estudiodaw</span><span class="text-muted-foreground">.dev</span>
    </a>

    <div class="flex-1"></div>

    <nav class="flex items-center gap-4 max-sm:hidden" aria-label="Asignaturas">
      {
        subjects.map((s) => (
          <a
            href={`/${s.id}`}
            class="text-sm font-medium tracking-wide text-muted-foreground transition-[color] hover:text-foreground aria-[current=page]:text-foreground"
            aria-current={current === s.id ? 'page' : undefined}
          >
            {s.data.short}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center">
      <span class="mr-2 h-5 w-px bg-border max-sm:hidden" aria-hidden="true"></span>
      <a
        href="https://github.com/albcantero/estudiodaw"
        class="inline-flex size-8 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        aria-label="Código en GitHub"
      >
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="size-4">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>
      <span class="mx-2 h-5 w-px bg-border" aria-hidden="true"></span>
      <button
        type="button"
        class="theme-toggle relative inline-flex size-8 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground active:scale-[0.98]"
        aria-label="Cambiar tema (tecla D)"
      >
        <svg class="theme-icon-moon size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
        <svg class="theme-icon-sun size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 3v1M12 20v1M3 12h1M20 12h1M5.6 5.6l.7.7M17.7 17.7l.7.7M5.6 18.4l.7-.7M17.7 6.3l.7-.7" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Módulo: se ejecuta una sola vez aunque se navegue con ClientRouter,
  // así que se escucha en el documento y no en cada botón.
  function toggleTheme() {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    root.style.colorScheme = dark ? 'dark' : 'light';
    try {
      localStorage.setItem('site-theme', dark ? 'dark' : 'light');
    } catch {}
  }

  document.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('.theme-toggle')) toggleTheme();
  });

  // Atajo "D" como en chanhdai, salvo escribiendo en un campo.
  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    if (event.key !== 'd' || event.metaKey || event.ctrlKey || event.altKey) return;
    if (target.closest('input, textarea, [contenteditable="true"]')) return;
    toggleTheme();
  });
</script>
