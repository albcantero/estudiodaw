---
import Icon from './Icon.astro';
import { GITHUB_URL, isSectionActive, normalizePath, sectionLinks } from '../data/site';

// Barra de móvil y de las páginas de lectura: las secciones (sin Inicio, que es la marca)
// y las acciones. Las asignaturas se eligen desde la portada.
const { class: className } = Astro.props;
const path = normalizePath(Astro.url.pathname);
const links = sectionLinks.filter((l) => l.href !== '/');
---

<header class:list={['sticky top-0 z-50 max-w-screen overflow-x-clip bg-background px-2 lg:px-0', className]}>
  <div class="screen-line-top screen-line-bottom screen-line-strong mx-auto flex h-(--header-height) items-center gap-2 border-x pr-2 pl-4 after:z-1 sm:gap-4 md:max-w-3xl">
    <a href="/" class="flex items-baseline text-[15px] font-medium tracking-tight" aria-label="Inicio">
      <span>estudiodaw</span><span class="text-muted-foreground">.dev</span>
    </a>

    <div class="flex-1"></div>

    <nav class="flex items-center gap-3 sm:gap-4" aria-label="Secciones">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm font-medium tracking-wide text-muted-foreground transition-[color] hover:text-foreground aria-[current=page]:text-foreground"
            aria-current={isSectionActive(path, l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center">
      <span class="mr-2 h-5 w-px bg-border" aria-hidden="true"></span>
      <button
        type="button"
        class="press-icon relative inline-flex size-8 items-center justify-center rounded-lg text-muted-foreground hover:bg-muted hover:text-foreground data-active:text-foreground"
        data-enrollment-open
        aria-haspopup="dialog"
        aria-label="Mi matrícula"
      >
        <Icon name="school" class="size-4" />
      </button>
      <a
        href={GITHUB_URL}
        class="press-icon inline-flex max-sm:hidden size-8 items-center justify-center rounded-lg text-muted-foreground hover:bg-muted hover:text-foreground"
        aria-label="Código en GitHub"
      >
        <Icon name="brand-github" class="size-4" />
      </a>
      <span class="mx-2 h-5 w-px bg-border max-sm:hidden" aria-hidden="true"></span>
      <button
        type="button"
        class="theme-toggle press-icon relative inline-flex size-8 items-center justify-center rounded-lg text-muted-foreground hover:bg-muted hover:text-foreground"
        aria-label="Cambiar tema (tecla D)"
      >
        <Icon name="moon" class="theme-icon-moon size-4" />
        <Icon name="sun" class="theme-icon-sun size-4" />
      </button>
    </div>
  </div>
</header>

<script>
  import { STORAGE_KEYS } from '../data/storage';

  // Módulo: se ejecuta una sola vez aunque se navegue con ClientRouter,
  // así que se escucha en el documento y no en cada botón.
  function toggleTheme() {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    root.style.colorScheme = dark ? 'dark' : 'light';
    try {
      localStorage.setItem(STORAGE_KEYS.theme, dark ? 'dark' : 'light');
    } catch {}
  }

  document.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('.theme-toggle')) toggleTheme();
  });

  // Atajo "D" como en chanhdai, salvo escribiendo en un campo.
  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    if (event.key !== 'd' || event.metaKey || event.ctrlKey || event.altKey) return;
    if (target.closest('input, textarea, [contenteditable="true"]')) return;
    toggleTheme();
  });
</script>
