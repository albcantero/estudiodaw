---
interface Props {
  href: string;
  number: string;
  label: string;
  title: string;
  description?: string;
  foot?: string;
  color?: string;
  /** Tarjeta con borde y fondo (asignaturas) en vez de fila con separador (temas). */
  boxed?: boolean;
}

const { href, number, label, title, description, foot, color, boxed = false } = Astro.props;
---

<article class:list={['card group', boxed && 'card-boxed']}>
  <a href={href} class="card-link">
    <div class="card-meta">
      <span class="card-num font-mono">{number}</span>
      {color && <span class="card-dot" style={`background:${color}`} aria-hidden="true" />}
      <span>{label}</span>
    </div>
    <h3 class="card-title font-heading">{title}</h3>
    {description && <p class="card-desc">{description}</p>}
    <div class="card-foot">
      {foot && <span>{foot}</span>}
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="card-arrow">
        <path d="M3 8h10M9 4l4 4-4 4" />
      </svg>
    </div>
  </a>
</article>

<style>
  .card {
    border-bottom: 1px solid var(--border);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 9.5rem;
    padding: 1.375rem 0 1.25rem;
    border-radius: 2px;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 11px;
    line-height: 1rem;
    color: var(--text-muted);
  }

  .card-num {
    font-variant-numeric: tabular-nums;
    color: var(--text-dim);
    margin-right: 0.25rem;
    transition: color 150ms ease;
  }

  .card-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
  }

  .card-title {
    font-size: 1.3125rem;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
    text-wrap: balance;
  }

  .card-desc {
    margin-top: 0.5rem;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .card-foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 11px;
    color: var(--text-muted);
  }

  .card-arrow {
    width: 14px;
    height: 14px;
    margin-left: auto;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 150ms ease, transform 200ms ease;
  }

  .card-boxed {
    border-bottom: 0;
  }

  .card-boxed .card-link {
    padding: 1.375rem 1.5rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    transition: border-color 150ms ease, background-color 150ms ease, transform 200ms ease;
  }

  .card-boxed:hover .card-link,
  .card-boxed:focus-within .card-link {
    border-color: var(--border-hover);
    background: var(--surface-2);
  }

  .card-boxed .card-title {
    font-size: 1.5rem;
  }

  .card:hover .card-num,
  .card:focus-within .card-num {
    color: var(--accent);
  }

  .card:hover .card-arrow,
  .card:focus-within .card-arrow {
    opacity: 1;
    transform: none;
  }
</style>
