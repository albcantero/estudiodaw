---
// Aviso del calendario con la forma exacta del bloque "Sponsored" de designeer.xyz:
// fondo accent-tint al 40 %, radio de tarjeta, título con icono en azul, etiqueta mono
// a la derecha, texto de 52ch y enlace con subrayado que aparece al pasar el ratón.
import Icon from './Icon.astro';
---

<section class="px-2 py-4 lg:px-[1.125rem]">
  <div class="rounded-[14px] bg-accent-tint/40 px-4 py-3.5 sm:px-5 sm:py-4">
    <div class="flex items-start justify-between gap-4">
      <span class="flex items-center gap-1.5 text-ui font-medium">
        <Icon name="calendar-event" class="size-[15px] text-accent-ink" strokeWidth={1.5} />
        Calendario de exámenes
      </span>
      <span class="shrink-0 font-mono text-[0.625rem] tracking-wider text-accent-ink uppercase">Curso 2026-27</span>
    </div>
    <p class="mt-1.5 max-w-[52ch] text-ui leading-relaxed text-pretty text-muted-foreground">
      Consulta el calendario de exámenes: parciales y finales de 1º y 2º, y finales del plan LOE, con la hora y la cuenta atrás de cada uno.
    </p>
    <a
      href="/calendario"
      class="group mt-2.5 inline-flex w-fit items-center gap-1 text-ui font-medium text-accent-ink underline decoration-transparent decoration-from-font underline-offset-[0.3em] transition-[text-decoration-color] duration-[220ms] ease-[cubic-bezier(0.23,1,0.32,1)] hover:decoration-current"
    >
      Ver el calendario
      <Icon name="arrow-up-right" class="size-[13px] transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5" strokeWidth={1.5} />
    </a>
  </div>
</section>
