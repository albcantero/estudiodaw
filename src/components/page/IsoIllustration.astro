---
/**
 * @file Ilustración isométrica lineal (las características de la portada, el estado vacío de las
 * colecciones y la obra del aviso de desarrollo), en línea para que se anime
 * (scripts/iso/illustrations.ts): sus capas suben una tras otra, los contornos se dibujan y algunas
 * piezas siguen en movimiento.
 *
 * Los SVG (src/assets/iso) traen su propio <style> y ids en sus capas. Al pintarlos se quitan
 * los dos: el <style> tiene clases genéricas (.s, .face, .dash…) que afectarían a toda la página,
 * así que esos estilos van aquí, con ámbito y con los colores de los tokens (claro y oscuro); y los
 * ids se repiten entre ilustraciones (guides, connector), así que pasan a data-layer. Decorativa:
 * el texto lo pone la tarjeta.
 *
 * @author Alberto Cantero
 * @license MIT
 */
import calendar from '../../assets/iso/calendar.svg?raw';
import code from '../../assets/iso/code.svg?raw';
import construction from '../../assets/iso/construction.svg?raw';
import emptySearch from '../../assets/iso/empty-search.svg?raw';
import notes from '../../assets/iso/notes.svg?raw';

const SOURCES = { notes, calendar, code, 'empty-search': emptySearch, construction };

interface Props {
  name: keyof typeof SOURCES;
  /** Quieta: ya montada, sin entrada; solo lo que sigue en movimiento (scripts/iso/illustrations.ts) */
  still?: boolean;
}

const { name, still = false } = Astro.props;

const svg = SOURCES[name]
  .replace(/<style>[\s\S]*?<\/style>/, '')
  .replace(/\s(role|aria-label)="[^"]*"/g, '')
  .replace(/\sid="/g, ' data-layer="');
---

<div class="iso" data-iso={name} data-iso-still={still || undefined} set:html={svg} />

<style>
  /* Colores de la ilustración, suaves (acompaña sin llamar la atención) y todos sólidos: ya
     mezclados con el fondo, sin transparencias, así donde se cruzan dos trazos o se solapan dos
     rellenos no se suman y el cruce no sale más claro. Por eso tampoco se baja con opacity.
     --iso-ink es el mando de la intensidad: la tinta, el gris del texto secundario rebajado hacia
     el fondo; de ella salen el trazo y las líneas tenues. */
  .iso {
    --iso-ink: color-mix(in oklab, var(--muted-foreground) 50%, var(--background));
    --iso-stroke: var(--iso-ink);
    --iso-dim: color-mix(in oklab, var(--iso-ink) 45%, var(--background));
    --iso-face: var(--background);
    --iso-side: color-mix(in oklab, var(--foreground) 3%, var(--background));
    --iso-dim-fill: color-mix(in oklab, var(--foreground) 6%, var(--background));
    --iso-accent: color-mix(in oklab, var(--iso-ink) 12%, var(--background));
    --iso-stroke-width: 1.25;
    --iso-bold-width: 1.75;
    width: 100%;
    height: 100%;
  }

  .iso :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .iso :global(.s) {
    fill: none;
    stroke: var(--iso-stroke);
    stroke-width: var(--iso-stroke-width);
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .iso :global(.face) {
    fill: var(--iso-face);
  }

  .iso :global(.side) {
    fill: var(--iso-side);
  }

  .iso :global(.dim) {
    stroke: var(--iso-dim);
  }

  .iso :global(.dash) {
    stroke-dasharray: 3 4;
  }

  .iso :global(.fill-dim) {
    fill: var(--iso-dim-fill);
    stroke: var(--iso-dim);
  }

  .iso :global(.fill-stroke) {
    fill: var(--iso-stroke);
  }

  .iso :global(.accent-fill) {
    fill: var(--iso-accent);
  }

  .iso :global(:is(.bold, .ring)) {
    stroke-width: var(--iso-bold-width);
  }

  .iso :global(.eo) {
    fill-rule: evenodd;
  }

  /* Hasta que entra (al verse por primera vez), sus capas no se ven: así no asoman enteras un
     instante antes de animarse. Sin JavaScript o reduciendo movimiento, se ven quietas; y las
     quietas (still), siempre. */
  @media (scripting: enabled) {
    :global(:root:not([data-reduce-motion]))
      .iso:not([data-iso-played], [data-iso-still])
      :global(svg > g) {
      opacity: 0;
    }
  }
</style>

<script>
  import '../../scripts/iso/illustrations';
</script>
