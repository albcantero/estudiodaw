---
// Botón de tema claro/oscuro (luna en claro, sol en oscuro) y atajo "D" como en chanhdai.
// Va en la barra superior, en la de móvil y en el panel lateral; cambia solo el tamaño.
import Icon from './Icon.astro';

interface Props {
  class?: string;
}

const { class: className = 'size-8' } = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle press-icon grid place-items-center rounded-lg text-muted-foreground hover:bg-muted hover:text-foreground', className]}
  aria-label="Cambiar tema (tecla D)"
>
  <Icon name="moon" class="theme-icon-moon size-4" />
  <Icon name="sun" class="theme-icon-sun size-4" />
</button>

<script>
  import { STORAGE_KEYS } from '../data/storage';

  // Módulo: se ejecuta una sola vez aunque se navegue con ClientRouter y aunque haya
  // varios botones, así que se escucha en el documento y no en cada botón.
  function toggleTheme() {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    root.style.colorScheme = dark ? 'dark' : 'light';
    try {
      localStorage.setItem(STORAGE_KEYS.theme, dark ? 'dark' : 'light');
    } catch {}
  }

  document.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('.theme-toggle')) toggleTheme();
  });

  // Atajo "D", salvo escribiendo en un campo o con un diálogo abierto.
  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    if (event.key.toLowerCase() !== 'd' || event.metaKey || event.ctrlKey || event.altKey) return;
    if (target.closest('input, textarea, [contenteditable="true"], dialog[open]')) return;
    toggleTheme();
  });
</script>
