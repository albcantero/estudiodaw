---
/**
 * @file Cuenta, en la barra superior: "Iniciar sesión" sin sesión (abre AuthDialog) y, con ella, el
 * avatar y el nombre de usuario, que abren un desplegable con el avatar, el nombre y el correo,
 * "Cambiar nombre", "Mi matrícula" (EnrollmentDialog) y "Cerrar sesión". La matrícula solo se
 * elige con la sesión iniciada.
 *
 * El avatar del desplegable se puede cambiar: al pasar el ratón enseña un lápiz y al pulsarlo
 * abre el selector de icono y color (scripts/auth/avatar.ts).
 *
 * Lo pinta scripts/auth/account.ts según data-state: loading (hueco reservado, sin nada
 * visible, para que no salte de "Iniciar sesión" al usuario), signed-out, signed-in u off (sin
 * Supabase configurado: no se ve).
 *
 * @author Alberto Cantero
 * @license MIT
 */
import { AVATAR_COLORS, AVATAR_ICONS } from '../../data/avatar';
import Avatar from '../ui/Avatar.astro';
import Button from '../ui/Button.astro';
import Dropdown from '../ui/Dropdown.astro';
import Icon from '../ui/Icon.astro';
---

<div class="account" data-account data-state="loading">
  <Button
    class="account-sign-in px-2"
    aria-haspopup="dialog"
    tooltip="Entrar con tu correo de educa.jcyl.es"
    tooltipSide="bottom"
    data-auth-open
  >
    <Icon name="login-2" class="size-4" />
    Iniciar sesión
  </Button>

  <div class="account-menu">
    <Dropdown
      id="account-menu"
      label="Tu cuenta"
      icon="user"
      size="default"
      width="w-64"
      tooltip={false}
      flush
    >
      <span slot="trigger" class="flex items-center gap-1.5">
        <Avatar size="sm" />
        <span class="max-w-40 truncate" data-account-username></span>
        <Icon name="chevron-down" class="size-3.5" />
      </span>
      {/* El avatar y, a su lado, el nombre y debajo el correo. El avatar abre su selector */}
      <div class="account-panel">
        <button
          type="button"
          class="avatar-edit focus-ring relative shrink-0 rounded-full"
          popovertarget="avatar-picker"
          aria-label="Cambiar avatar"
          data-avatar-edit
        >
          <Avatar />
          <span class="avatar-edit-overlay" aria-hidden="true">
            <Icon name="edit-circle" class="size-4" />
          </span>
        </button>
        <div class="min-w-0">
          <p class="account-name" data-account-name></p>
          <p class="account-email" data-account-email></p>
        </div>
      </div>
      {/* Selector del avatar: dentro del menú, para que elegir algo no lo cierre */}
      <div id="avatar-picker" popover class="avatar-picker" data-avatar-picker>
        <p class="avatar-picker-label" id="avatar-picker-icons">
          Icono
        </p>
        <div class="grid grid-cols-5 gap-1" role="group" aria-labelledby="avatar-picker-icons">
          {AVATAR_ICONS.map((icon) => (
            <button
              type="button"
              class="focus-ring grid size-9 place-items-center rounded-lg text-muted-foreground transition-colors hover:bg-hover hover:text-foreground aria-pressed:bg-pressed aria-pressed:text-foreground"
              aria-label={icon.label}
              aria-pressed="false"
              data-avatar-pick-icon={icon.id}
            >
              <Icon name={icon.id} class="size-5" />
            </button>
          ))}
        </div>
        <p class="avatar-picker-label mt-3" id="avatar-picker-colors">
          Color
        </p>
        <div
          class="grid grid-cols-8 place-items-center"
          role="group"
          aria-labelledby="avatar-picker-colors"
        >
          {AVATAR_COLORS.map((color) => (
            <button
              type="button"
              class:list={['avatar-swatch focus-ring', color.className]}
              aria-label={color.label}
              aria-pressed="false"
              data-avatar-pick-color={color.id}
            />
          ))}
        </div>
      </div>
      <div class="account-actions">
        {/* Primero lo de la cuenta; después, lo que cambia la web */}
        <Button class="w-full justify-start px-2" aria-haspopup="dialog" data-auth-rename>
          <Icon name="user-edit" class="size-4" />
          Cambiar nombre
        </Button>
        {/* Con un filtro de matrícula activo (data-active, de scripts/enrollment.ts), su punto */}
        <Button
          class="group/enroll w-full justify-start px-2 data-active:text-foreground"
          aria-haspopup="dialog"
          data-enrollment-open
        >
          <Icon name="school" class="size-4" />
          Mi matrícula
          <span
            class="marker-dot ml-auto hidden group-data-active/enroll:block"
            aria-hidden="true"
          ></span>
          <span class="sr-only hidden group-data-active/enroll:inline">(filtro activo)</span>
        </Button>
        {/* Aparte, tras una línea, para no pulsarla por error al buscar otra opción. En rojo (texto,
            icono y fondo) solo al pasar el ratón y al pulsar: avisa de que saca de la cuenta */}
        <div class="account-separator" role="separator"></div>
        <Button
          class="w-full justify-start px-2 hover:bg-destructive/10 hover:text-destructive active:bg-destructive/10"
          data-auth-sign-out
        >
          <Icon name="logout" class="size-4" />
          Cerrar sesión
        </Button>
      </div>
    </Dropdown>
  </div>

  {/* Separa la cuenta del resto de acciones; con ella se va si no hay login (off) */}
  <span class="mx-2 h-5 w-px bg-border" aria-hidden="true"></span>
</div>

<style>
  .account {
    display: flex;
    align-items: center;
  }

  /* Mientras carga, el hueco del botón "Iniciar sesión" sin pintar nada */
  .account[data-state='loading'] {
    visibility: hidden;
  }

  .account[data-state='off'],
  .account:not([data-state='signed-in']) .account-menu,
  .account[data-state='signed-in'] :global(.account-sign-in) {
    display: none;
  }

  /* A los lados, 12 px: el texto cae en la misma vertical que los iconos de las opciones (el
     relleno de la lista, 4 px, más el del botón, 8 px) */
  /* Avatar editable: al pasar el ratón o con el foco, lo tapa el fondo de hover de los botones
     (ya mezclado con el de la tarjeta, para que no se transparente lo de debajo) con un lápiz */
  .avatar-edit {
    cursor: pointer;
  }

  .avatar-edit-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--pressed) var(--hover-step), var(--popover));
    color: var(--foreground);
    opacity: 0;
    transition: opacity var(--duration-hover) var(--ease-hover);
  }

  .avatar-edit:hover .avatar-edit-overlay,
  .avatar-edit:focus-visible .avatar-edit-overlay,
  .avatar-edit[aria-expanded='true'] .avatar-edit-overlay {
    opacity: 1;
  }

  /* Selector: la superficie de los menús, debajo del avatar (lo coloca el script) */
  .avatar-picker {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: calc(var(--spacing) * 2);
    border: 1px solid var(--popover-border);
    border-radius: var(--radius-xl);
    background: var(--popover);
    color: var(--popover-foreground);
    box-shadow: var(--shadow-popover);
  }

  .avatar-picker-label {
    margin-bottom: calc(var(--spacing) * 1.5);
    padding-inline: calc(var(--spacing) * 1);
    font-size: var(--text-xs);
    line-height: var(--text-xs--line-height);
    color: var(--muted-foreground);
  }

  /* Muestra de color: un círculo de 20 px en su columna; el elegido, con un anillo del color del
     texto, que cabe en la columna sin tocar los de al lado */
  .avatar-swatch {
    width: calc(var(--spacing) * 5);
    height: calc(var(--spacing) * 5);
    border-radius: 9999px;
    cursor: pointer;
  }

  .avatar-swatch[aria-pressed='true'] {
    outline: 2px solid var(--foreground);
    outline-offset: 2px;
  }

  .account-panel {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2.5);
    padding: calc(var(--spacing) * 2.5) calc(var(--spacing) * 3);
  }

  /* Arriba el nombre y, debajo, el correo en gris */
  .account-name {
    overflow: hidden;
    font-size: var(--text-ui);
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .account-email {
    overflow: hidden;
    font-size: var(--text-xs);
    line-height: var(--text-xs--line-height);
    color: var(--muted-foreground);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .account-actions {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 0.5);
    padding: calc(var(--spacing) * 1);
    border-top: 1px solid var(--border);
  }

  /* Línea entre las opciones y "Cerrar sesión", de lado a lado del menú */
  .account-separator {
    height: 1px;
    margin: calc(var(--spacing) * 0.5) calc(var(--spacing) * -1);
    background: var(--border);
  }
</style>

<script>
  import '../../scripts/auth/account';
  import '../../scripts/auth/avatar';
</script>
