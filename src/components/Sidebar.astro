---
import Icon from './Icon.astro';
// Panel lateral izquierdo fijo, portado de designeer.xyz: marca, descripción,
// navegación con contadores y pie con enlaces.
// Persiste entre páginas (transition:persist): el enlace activo lo actualiza el script.
import { getCollection } from 'astro:content';

const subjects = (await getCollection('subjects')).sort((a, b) => a.data.order - b.data.order);
const temas = await getCollection('temas');
const count = (id: string) => temas.filter((t) => t.data.subject === id).length;
const { class: className } = Astro.props;
const current = Astro.url.pathname.split('/')[1] ?? '';
---

<aside class:list={['sidebar flex flex-col lg:sticky lg:top-0 lg:h-dvh lg:min-h-0', className]} transition:persist="sidebar" transition:name="sidebar" transition:animate="none">
  <div class="flex min-h-0 flex-col px-5 pt-[clamp(2rem,6vh,3.25rem)] pb-5 lg:h-full">
    <div class="shrink-0">
      <a href="/" class="rise block w-fit rounded-full focus-visible:outline-2 focus-visible:outline-offset-2" style="--d:0ms" aria-label="estudiodaw.dev, inicio">
        <span class="grid size-16 place-items-center rounded-full bg-foreground font-pixel text-2xl leading-none text-background select-none" aria-hidden="true">ed</span>
      </a>
      <a href="/" class="rise mt-6 flex w-fit items-center font-pixel text-[1.125rem] leading-none" style="--d:80ms">
        estudiodaw<span class="text-muted-foreground">.dev</span>
      </a>
      <p class="rise mt-3 max-w-[34ch] text-[0.8125rem] leading-relaxed text-pretty" style="--d:160ms">
        Apuntes, ejercicios y soluciones de DAW, tema a tema. Se escriben mientras se estudia y se comparten con la clase.
      </p>
    </div>

    <div class="rise mt-7 flex min-h-0 flex-1 flex-col overflow-y-auto border-t border-dashed pt-5 [scrollbar-width:none]" style="--d:320ms">
      <p class="mb-2 font-mono text-[0.625rem] tracking-wider text-muted-foreground uppercase">Navegación</p>
      <nav aria-label="Navegación">
        <ul class="flex flex-col">
          <li>
            <a href="/calendario" class="nav-link press">
              <Icon name="calendar" class="size-4 shrink-0" />
              <span class="truncate">Fechas de exámenes</span>
            </a>
          </li>
          {
            subjects.map((s) => {
              const active = current === s.id;
              const n = count(s.id);
              return (
                <li>
                  <a href={`/${s.id}`} class:list={['nav-link press', active && 'is-active']} aria-current={active ? 'page' : undefined} title={s.data.name}>
                    <span class="grid size-4 shrink-0 place-items-center" aria-hidden="true">
                      <span class="size-1.5 rounded-full" style={`background:${s.data.color}`} />
                    </span>
                    <span class="truncate">{s.data.name}</span>
                    <span class:list={['ml-auto font-mono text-[0.625rem] tabular-nums', n === 0 ? 'text-muted-foreground/60' : 'text-muted-foreground']}>{n}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

    </div>

    <div class="rise mt-5 flex shrink-0 items-center justify-between gap-2 border-t border-dashed pt-5" style="--d:400ms">
      <div class="flex items-center gap-3 text-[0.8125rem] text-muted-foreground">
        <a class="transition-colors hover:text-foreground" href="https://github.com/albcantero/estudiodaw" target="_blank" rel="noopener">GitHub</a>
        <a class="transition-colors hover:text-foreground" href="/#asignaturas">Índice</a>
      </div>
      <button
        type="button"
        class="theme-toggle press-icon inline-flex size-7 items-center justify-center rounded-[10px] text-muted-foreground hover:bg-muted hover:text-foreground"
        aria-label="Cambiar tema (tecla D)"
      >
        <Icon name="moon" class="theme-icon-moon size-4" />
        <Icon name="sun" class="theme-icon-sun size-4" />
      </button>
    </div>
  </div>
</aside>

<style>
  .nav-link {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 6px;
    padding: 0.375rem 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--muted-foreground);
  }

  .nav-link:hover {
    color: var(--foreground);
    background: var(--accent-muted);
  }

  .nav-link.is-active {
    font-weight: 500;
    color: var(--foreground);
    background: var(--muted);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  @media (pointer: coarse) {
    .nav-link {
      padding-block: 0.625rem;
    }
  }
</style>

<script>
  // El panel no se vuelve a renderizar al navegar: se marca el activo según la URL.
  function markActive() {
    const section = location.pathname.split('/')[1] ?? '';
    document.querySelectorAll<HTMLAnchorElement>('.sidebar .nav-link').forEach((link) => {
      const target = new URL(link.href).pathname.split('/')[1] ?? '';
      const active = section !== '' && target === section;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  document.addEventListener('astro:page-load', markActive);

  // Al persistir, Astro mueve el mismo nodo al <body> nuevo y el navegador reinicia sus
  // animaciones CSS: la entrada escalonada se repetía en cada navegación. Se marca el
  // panel antes del cambio para que las animaciones de entrada solo corran la primera vez.
  document.addEventListener('astro:before-swap', () => {
    document.querySelector('.sidebar')?.setAttribute('data-entered', '');
  });
</script>
