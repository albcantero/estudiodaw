# Copia este fichero como .env y rellena los valores. .env no se sube nunca al repositorio.
#
# Sin .env, la web funciona igual en desarrollo (npm run dev) con el login de mentira: no hace
# falta Supabase para tocarla. Para el de verdad, dos opciones:
#  - Tu proyecto de Supabase: Project Settings → API.
#  - Una base de datos local (npx supabase start, ver docs/supabase-setup.md): la URL es
#    http://127.0.0.1:54321 y la clave anon la escribe la CLI al arrancar. Y PUBLIC_AUTH_MODE=real.

# URL del proyecto de Supabase
PUBLIC_SUPABASE_URL=

# Clave pública (anon): va en la web publicada. Lo que protege los datos son las políticas RLS
PUBLIC_SUPABASE_ANON_KEY=

# Solo en desarrollo: el login es de mentira (sin correos; vale el código 123456). Con "real",
# usa Supabase de verdad y envía correos
PUBLIC_AUTH_MODE=
